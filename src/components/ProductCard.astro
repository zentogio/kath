---
import { Image } from 'astro:assets';
import { unsplashUrl, formatPrice, type Product } from '../data/products';

interface Props {
	product: Product;
	priority?: boolean;
	index?: number;
	featured?: boolean;
}

const { product, priority = false, index = 0, featured = false } = Astro.props;
---

<li
	class:list={['product-card', { 'product-card--featured': featured }]}
	data-reveal
	style={`--i: ${index % 8}`}
>
	<button
		type="button"
		class="product-card__media"
		data-quickview-open={product.id}
		aria-label={`View ${product.name}`}
	>
		<Image
			src={unsplashUrl(product.image, featured ? 1400 : 1000)}
			alt={product.alt}
			width={featured ? 1200 : 760}
			height={featured ? 1000 : 950}
			loading={priority ? 'eager' : 'lazy'}
			fetchpriority={priority ? 'high' : 'auto'}
			class="product-photo"
		/>
		{product.soldOut && <span class="product-card__badge">Sold Out</span>}
		{featured && <span class="product-card__featured-tag label">This Season</span>}
	</button>
	<div class="product-card__body">
		<button type="button" class="product-card__info" data-quickview-open={product.id}>
			<h3 class="title product-card__name">{product.name}</h3>
			<p class="product-card__price">{formatPrice(product.price)}</p>
		</button>
		<button
			type="button"
			class="btn btn-ghost product-card__add"
			data-add-to-cart={product.id}
			data-magnetic={featured ? '' : undefined}
			disabled={product.soldOut}
		>
			<span data-add-label>{product.soldOut ? 'Sold Out' : 'Add to Cart'}</span>
		</button>
	</div>
</li>

<style>
	.product-card {
		list-style: none;
		display: flex;
		flex-direction: column;
	}

	.product-card__media {
		position: relative;
		overflow: hidden;
		aspect-ratio: 4 / 5;
		background: var(--color-paper-sunk);
		display: block;
		width: 100%;
		border: none;
		padding: 0;
		margin: 0;
		cursor: pointer;
		font: inherit;
	}

	.product-card--featured {
		grid-column: span 2;
	}

	.product-card--featured .product-card__media {
		aspect-ratio: 16 / 10;
	}

	.product-card--featured .product-card__name {
		font-size: var(--text-headline);
	}

	@media (max-width: 640px) {
		.product-card--featured {
			grid-column: span 1;
		}

		.product-card--featured .product-card__media {
			aspect-ratio: 4 / 5;
		}

		.product-card--featured .product-card__name {
			font-size: var(--text-title);
		}
	}

	.product-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: contrast(1.03) saturate(1.05);
		transition: transform var(--duration-slow) var(--ease-out-quart);
	}

	@media (hover: hover) {
		.product-card:hover .product-photo {
			transform: scale(1.04);
		}
	}

	.product-card__badge {
		position: absolute;
		top: var(--space-sm);
		left: var(--space-sm);
		font-family: var(--font-body);
		font-size: var(--text-caption);
		font-weight: 600;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--color-accent);
		background: var(--color-paper);
		border: 1px solid var(--color-accent);
		padding: 0.3em 0.6em;
	}

	.product-card__featured-tag {
		position: absolute;
		top: var(--space-sm);
		right: var(--space-sm);
		color: var(--color-paper);
		background: var(--color-ink);
		padding: 0.3em 0.7em;
	}

	.product-card__body {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-sm);
		padding-top: var(--space-sm);
	}

	.product-card__info {
		display: block;
		text-align: left;
		background: none;
		border: none;
		padding: 0;
		margin: 0;
		cursor: pointer;
		font: inherit;
		min-width: 0;
	}

	.product-card__info:hover .product-card__name {
		color: var(--color-graphite);
	}

	.product-card__name {
		margin: 0 0 0.3em;
		transition: color var(--duration-fast) var(--ease-out-quart);
	}

	.product-card__price {
		margin: 0;
		color: var(--color-graphite);
		font-size: var(--text-body);
	}

	.product-card__add {
		flex-shrink: 0;
		padding: 0.7em 1.2em;
	}

	.product-card__add.is-added {
		background: var(--color-ink);
		color: var(--color-paper);
	}
</style>
