---
import { Image } from 'astro:assets';
import instagramMark from '../assets/brand/social/instagram-mark.png';
import facebookMark from '../assets/brand/social/facebook-mark.png';
import shopeeMark from '../assets/brand/social/shopee-mark.png';
import lazadaMark from '../assets/brand/social/lazada-mark.png';

interface Props {
	invert?: boolean;
	size?: 'sm' | 'lg';
	class?: string;
}

const { invert = false, size = 'sm', class: className = '' } = Astro.props;

// Each icon keeps its own source aspect ratio (a square outline, a tall
// glyph, a wider bag shape) — width/height below preserve that ratio at a
// shared render height; CSS then scales all three down to the same
// on-screen height without stretching any of them.
const links = [
	{
		href: 'https://www.instagram.com/studio.kath/',
		label: 'Instagram',
		icon: instagramMark,
		width: 120,
		height: 120,
	},
	{
		href: 'https://www.facebook.com/kathh.studio/',
		label: 'Facebook',
		icon: facebookMark,
		width: 67,
		height: 120,
	},
	{
		href: 'https://shopee.co.th/studio.kath',
		label: 'Shopee',
		icon: shopeeMark,
		width: 106,
		height: 120,
	},
	{
		href: 'https://s.lazada.co.th/s.ZR0XvK?c=x',
		label: 'Lazada',
		icon: lazadaMark,
		width: 149,
		height: 120,
	},
];
---

<div class:list={['social-links', `social-links--${size}`, className]}>
	{
		links.map((link) => (
			<a
				href={link.href}
				target="_blank"
				rel="noreferrer"
				class="social-links__item"
				aria-label={link.label}
			>
				<span class="social-links__icon-box">
					<Image
						src={link.icon}
						alt=""
						width={link.width}
						height={link.height}
						class:list={['social-links__icon', { 'brand-mark--invert': invert }]}
					/>
				</span>
				<span class="visually-hidden">{link.label}</span>
			</a>
		))
	}
</div>

<style>
	/* A horizontal row of equal-footprint icon boxes — each source icon has
	   its own aspect ratio (a square outline, a tall glyph, a wider bag
	   shape), so a vertical list of icon+label pairs left-ragged the labels
	   against each other. A row of fixed-size boxes keeps every icon on the
	   same baseline and the same footprint regardless of its own shape. */
	.social-links {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-md);
	}

	.social-links__item {
		display: inline-flex;
		text-decoration: none;
		color: inherit;
		opacity: 0.85;
		transition: opacity var(--duration-fast) var(--ease-out-quart);
	}

	.social-links__item:hover {
		opacity: 1;
	}

	.social-links__icon-box {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 24px;
		height: 24px;
	}

	.social-links__icon {
		max-height: 100%;
		max-width: 100%;
		width: auto;
		height: auto;
		flex-shrink: 0;
	}

	.social-links--lg {
		gap: var(--space-lg);
	}

	.social-links--lg .social-links__icon-box {
		width: 32px;
		height: 32px;
	}
</style>
