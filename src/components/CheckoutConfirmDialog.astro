---
---

<dialog class="confirm-dialog" data-confirm-dialog aria-label="Please read before continuing">
	<div class="confirm-dialog__panel">
		<button
			type="button"
			class="icon-btn confirm-dialog__close"
			data-confirm-close
			data-i18n-attr="aria-label:common.close"
			aria-label="Close"
		>
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path
					d="M5 5l14 14M19 5 5 19"
					stroke="currentColor"
					stroke-width="1.4"
					stroke-linecap="round"></path>
			</svg>
		</button>

		<p class="title confirm-dialog__title" data-i18n="checkoutConfirm.title">
			Please read before continuing
		</p>

		<ul class="confirm-dialog__list">
			<li data-i18n="checkoutConfirm.bullet1">
				Please double-check your shipping address before paying — it cannot be changed
				afterward.
			</li>
			<li data-i18n="checkoutConfirm.bullet2">
				Please double-check your size — if you're unsure, feel free to ask our admin
				anytime.
			</li>
			<li data-i18n="checkoutConfirm.bullet3">
				We do not accept returns or exchanges for reasons of personal fit or preference
				after wearing.
			</li>
			<li data-i18n="checkoutConfirm.bullet4">
				Size exchanges are accepted within 7 days, with the item and tags in original
				condition — we'll ship the replacement within 7–10 business days.
			</li>
			<li data-i18n="checkoutConfirm.bullet5">
				For made-to-order trousers or any other questions, add us on LINE OFFICIAL:
				@studiokath
			</li>
		</ul>

		<div class="confirm-dialog__actions">
			<button type="button" class="btn btn-ghost" data-confirm-close data-i18n="common.close">Close</button>
			<button type="button" class="btn btn-primary" data-confirm-proceed data-i18n="checkoutConfirm.proceed"
				>Go to Payment</button
			>
		</div>
	</div>
</dialog>

<style is:global>
	/* Same centered-modal pattern as the quickview / size dialogs. */
	.confirm-dialog {
		position: fixed;
		inset: 0;
		margin: auto;
		width: min(28rem, calc(100vw - 2rem));
		max-height: calc(100vh - 3rem);
		padding: 0;
		border: none;
		background: var(--color-paper);
		box-shadow: var(--shadow-overlay);
		overflow-y: auto;
		scale: 0.96;
		opacity: 0;
		transition:
			scale var(--duration-base) var(--ease-out-quart),
			opacity var(--duration-base) var(--ease-out-quart),
			overlay var(--duration-base) allow-discrete,
			display var(--duration-base) allow-discrete;
	}

	.confirm-dialog[open] {
		scale: 1;
		opacity: 1;
	}

	@starting-style {
		.confirm-dialog[open] {
			scale: 0.96;
			opacity: 0;
		}
	}

	.confirm-dialog::backdrop {
		background: rgba(20, 12, 12, 0.4);
		backdrop-filter: blur(10px);
		transition:
			background var(--duration-base) var(--ease-out-quart),
			backdrop-filter var(--duration-base) var(--ease-out-quart),
			overlay var(--duration-base) allow-discrete,
			display var(--duration-base) allow-discrete;
	}

	@starting-style {
		.confirm-dialog[open]::backdrop {
			background: rgba(20, 12, 12, 0);
			backdrop-filter: blur(0px);
		}
	}

	/* Same mobile Safari fix as the other dialogs — blurred ::backdrop
	   bleeds onto the dialog's own content on iOS. */
	@media (max-width: 720px) {
		.confirm-dialog[open]::backdrop {
			background: rgba(20, 12, 12, 0.6);
			backdrop-filter: none;
		}

		@starting-style {
			.confirm-dialog[open]::backdrop {
				background: rgba(20, 12, 12, 0);
			}
		}
	}

	.confirm-dialog__panel {
		position: relative;
		padding: var(--space-xl);
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
	}

	.confirm-dialog__close {
		position: absolute;
		top: var(--space-sm);
		right: var(--space-sm);
	}

	.confirm-dialog__title {
		padding-right: var(--space-xl);
	}

	.confirm-dialog__list {
		margin: 0;
		padding-left: 1.1em;
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		font-size: var(--text-body);
		color: var(--color-graphite);
	}

	.confirm-dialog__actions {
		display: flex;
		gap: var(--space-sm);
	}

	.confirm-dialog__actions .btn {
		flex: 1;
	}
</style>
