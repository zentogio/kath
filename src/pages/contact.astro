---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import SocialLinks from '../components/SocialLinks.astro';
import lineMark from '../assets/brand/social/line-mark.png';
import lazadaMark from '../assets/brand/social/lazada-mark.png';
---

<Layout
	title="Contact"
	description="Get in touch with Studio Kath — questions, custom orders, or studio visits."
>
	<header class="container contact-header">
		<p class="eyebrow">Get in Touch</p>
		<h1 class="display contact-header__title">Let's talk about a piece.</h1>
		<p class="prose">
			Whether you have a question about sizing, want to ask about a piece that's sold
			out, or you'd like to visit the studio — reach out directly, any way below.
		</p>
	</header>

	<section class="container contact-grid">
		<div class="contact-channels">
			<div class="contact-channel">
				<p class="eyebrow">Call</p>
				<a
					class="contact-channel__link contact-channel__link--icon title"
					href="tel:+66815638883"
				>
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path
							d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3.9c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.3 0 .7-.2 1L6.6 10.8Z"
							stroke="currentColor"
							stroke-width="1.4"
							stroke-linejoin="round"
							stroke-linecap="round"></path>
					</svg>
					+66 8 1563 8883
				</a>
			</div>
			<div class="contact-channel">
				<p class="eyebrow">Line</p>
				<a
					class="contact-channel__link contact-channel__link--icon title"
					href="https://lin.ee/9TUJj1q"
					target="_blank"
					rel="noreferrer"
				>
					<Image src={lineMark} alt="" width={22} height={21} class="contact-channel__icon" />
					@studiokath
				</a>
			</div>
			<div class="contact-channel">
				<p class="eyebrow">Email</p>
				<a class="contact-channel__link title" href="mailto:info.studiokath@gmail.com"
					>info.studiokath@gmail.com</a
				>
			</div>
			<div class="contact-channel">
				<p class="eyebrow">Shop</p>
				<a
					class="contact-channel__link contact-channel__link--icon title"
					href="https://s.lazada.co.th/s.ZR0XvK?c=x"
					target="_blank"
					rel="noreferrer"
				>
					<Image src={lazadaMark} alt="" width={22} height={18} class="contact-channel__icon" />
					Shop on Lazada
				</a>
			</div>
			<div class="contact-channel">
				<p class="eyebrow">Follow &amp; Shop</p>
				<SocialLinks size="lg" class="contact-channel__social" />
			</div>
			<div class="contact-channel">
				<p class="eyebrow">Studio</p>
				<p class="prose contact-channel__address">
					Bangkok, Thailand<br />
					By appointment — message ahead to arrange a visit.
				</p>
			</div>
		</div>
	</section>
</Layout>

<style>
	.contact-header {
		padding-top: var(--space-2xl);
		max-width: 40rem;
	}

	.contact-header__title {
		margin-block: var(--space-sm) var(--space-md);
	}

	.contact-grid {
		padding-block: var(--space-2xl) var(--space-3xl);
	}

	.contact-channels {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-2xl) var(--space-3xl);
		max-width: 44rem;
	}

	@media (min-width: 640px) {
		.contact-channels {
			grid-template-columns: 1fr 1fr;
		}
	}

	.contact-channel {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}

	.contact-channel .eyebrow {
		font-size: var(--text-label);
	}

	.contact-channel__link {
		text-decoration: none;
		color: var(--color-ink);
		width: fit-content;
		font-size: 1.375rem;
		border-bottom: 1px solid var(--color-border-strong);
		transition: border-color var(--duration-fast) var(--ease-out-quart);
	}

	.contact-channel__link--icon {
		display: inline-flex;
		align-items: center;
		gap: var(--space-xs);
		border-bottom: none;
		transition: color var(--duration-fast) var(--ease-out-quart);
	}

	.contact-channel__icon {
		height: 22px;
		width: auto;
		flex-shrink: 0;
	}

	.contact-channel__link--icon:hover {
		color: var(--color-accent);
	}

	.contact-channel__link:hover {
		border-color: var(--color-accent);
	}

	.contact-channel__address {
		margin: 0;
		font-size: var(--text-body-lg);
	}

	.contact-channel__social :global(.social-links__item) {
		font-size: 1.375rem;
	}

	.contact-channel__social :global(.social-links__icon) {
		height: 22px;
	}
</style>
