---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Checkout" description="Review your order and enter shipping details.">
	<header class="container checkout-header">
		<p class="eyebrow">Checkout</p>
		<h1 class="display checkout-header__title">Review your order.</h1>
	</header>

	<section class="container checkout-grid" data-checkout-grid>
		<div class="checkout-summary">
			<ul class="checkout-items" data-checkout-items></ul>
			<div class="checkout-totals">
				<div class="checkout-totals__row checkout-totals__row--total">
					<span>Total</span>
					<span data-checkout-total></span>
				</div>
			</div>
		</div>

		<form class="checkout-form" data-checkout-form>
			<h2 class="title">Shipping details</h2>
			<label class="checkout-field">
				<span class="label">Full name</span>
				<input type="text" name="name" required autocomplete="name" />
			</label>
			<label class="checkout-field">
				<span class="label">Address</span>
				<textarea name="address" required autocomplete="street-address" rows="3"></textarea>
			</label>
			<label class="checkout-field">
				<span class="label">Phone</span>
				<input type="tel" name="phone" required autocomplete="tel" />
			</label>
			<p class="checkout-form__note">
				Saved on this device — it'll fill in automatically next time you order.
			</p>
			<button type="submit" class="btn btn-primary checkout-form__submit"
				>Continue to Payment</button
			>
		</form>
	</section>

	<div class="container checkout-empty" data-checkout-empty hidden>
		<p class="prose">Your cart is empty.</p>
		<a href="/collection" class="btn btn-ghost">Browse the Collection</a>
	</div>

	<script src="../../scripts/checkout.ts"></script>
</Layout>

<style>
	.checkout-header {
		padding-top: var(--space-2xl);
		max-width: 40rem;
	}

	.checkout-header__title {
		margin-top: var(--space-sm);
	}

	.checkout-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-2xl);
		padding-block: var(--space-2xl) var(--space-3xl);
	}

	@media (min-width: 860px) {
		.checkout-grid {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-3xl);
			align-items: start;
		}
	}

	.checkout-items {
		list-style: none;
		margin: 0 0 var(--space-lg);
		padding: 0;
		border-top: 1px solid var(--color-border);
	}

	.checkout-item {
		display: grid;
		grid-template-columns: 4rem 1fr auto;
		gap: var(--space-sm);
		align-items: center;
		padding-block: var(--space-sm);
		border-bottom: 1px solid var(--color-border);
	}

	.checkout-item img {
		width: 4rem;
		height: 5rem;
		object-fit: cover;
		filter: contrast(1.03) saturate(1.05);
	}

	.checkout-item__name {
		margin: 0;
		font-size: var(--text-body);
		font-weight: 500;
	}

	.checkout-item__meta {
		margin: 0.2em 0 0;
		font-size: var(--text-label);
		color: var(--color-graphite);
	}

	.checkout-item__price {
		margin: 0;
		font-size: var(--text-body);
		white-space: nowrap;
	}

	.checkout-totals {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
	}

	.checkout-totals__row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		color: var(--color-graphite);
		font-size: var(--text-body);
	}

	.checkout-totals__row--total {
		margin-top: var(--space-2xs);
		padding-top: var(--space-sm);
		border-top: 1px solid var(--color-border-strong);
		color: var(--color-ink);
		font-size: var(--text-title);
		font-weight: 500;
	}

	.checkout-form {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
	}

	.checkout-field {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
	}

	.checkout-field input,
	.checkout-field textarea {
		border: 1px solid var(--color-border-strong);
		background: var(--color-paper);
		padding: var(--space-sm);
		font-family: var(--font-body);
		font-size: var(--text-body);
		color: var(--color-ink);
		resize: vertical;
	}

	.checkout-field input:focus-visible,
	.checkout-field textarea:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 1px;
	}

	.checkout-form__note {
		margin: 0;
		font-size: var(--text-caption);
		color: var(--color-graphite);
	}

	.checkout-form__submit {
		width: 100%;
		margin-top: var(--space-xs);
	}

	.checkout-empty {
		padding-block: var(--space-3xl);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-md);
	}
</style>
