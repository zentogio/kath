---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Payment" description="Complete your payment for Studio Kath.">
	<header class="container checkout-header">
		<p class="eyebrow" data-i18n="checkout.eyebrow">Checkout</p>
		<h1 class="display checkout-header__title" data-i18n="payment.title">Choose how to pay.</h1>
	</header>

	<section class="container payment-grid" data-payment-grid hidden>
		<div class="payment-summary">
			<p class="label payment-summary__order"
				><span data-i18n="payment.order">Order</span> <span data-payment-order-id></span></p
			>
			<p class="payment-summary__total" data-payment-total></p>
		</div>

		<div class="payment-methods">
			<div class="payment-tabs" role="tablist">
				<button type="button" class="payment-tab is-active" data-payment-tab="qr" data-i18n="payment.tabQr"
					>PromptPay QR</button
				>
				<button type="button" class="payment-tab" data-payment-tab="bank" data-i18n="payment.tabBank"
					>Bank Transfer</button
				>
			</div>

			<div class="payment-panel" data-payment-panel="qr">
				<div class="payment-qr" data-payment-qr>
					<div class="payment-qr__placeholder" aria-hidden="true"></div>
				</div>
				<p class="prose payment-panel__note" data-i18n="payment.qrNote">
					Scan with your banking app — the amount is filled in automatically.
				</p>
			</div>

			<div class="payment-panel" data-payment-panel="bank" hidden>
				<dl class="payment-bank">
					<div>
						<dt data-i18n="payment.bankLabel">Bank</dt>
						<dd>Kasikornbank (K PLUS)</dd>
					</div>
					<div>
						<dt data-i18n="payment.accountNameLabel">Account name</dt>
						<dd>Studio Kath</dd>
					</div>
					<div>
						<dt data-i18n="payment.accountNumberLabel">Account number</dt>
						<dd>XXX-X-XXXXX-X</dd>
					</div>
				</dl>
				<p class="prose payment-panel__note" data-i18n="payment.bankNote">
					Transfer the exact total above, then confirm below.
				</p>
			</div>

			<button type="button" class="btn btn-primary payment-confirm" data-payment-confirm data-i18n="payment.confirm"
				>I've Completed Payment</button
			>
			<p class="payment-note" data-i18n="payment.confirmNote">
				We'll confirm your payment shortly — no need to send a slip separately.
			</p>
		</div>
	</section>

	<div class="container checkout-empty" data-checkout-empty hidden>
		<p class="prose" data-i18n="payment.empty">No order in progress.</p>
		<a href="/collection" class="btn btn-ghost" data-i18n="common.browseCollection">Browse the Collection</a>
	</div>

	<script src="../../../scripts/checkout-payment.ts"></script>
</Layout>

<style>
	.checkout-header {
		padding-top: var(--space-2xl);
		max-width: 40rem;
	}

	.checkout-header__title {
		margin-top: var(--space-sm);
	}

	.payment-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-xl);
		padding-block: var(--space-2xl) var(--space-3xl);
		max-width: 32rem;
	}

	.payment-summary {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		padding-bottom: var(--space-md);
		border-bottom: 1px solid var(--color-border);
	}

	.payment-summary__order {
		color: var(--color-graphite);
	}

	.payment-summary__total {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-headline);
	}

	.payment-methods {
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
	}

	.payment-tabs {
		display: flex;
		border: 1px solid var(--color-border-strong);
		width: fit-content;
	}

	.payment-tab {
		background: none;
		border: none;
		padding: 0.6em 1.2em;
		font-family: var(--font-body);
		font-weight: 500;
		font-size: var(--text-label);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--color-graphite);
		cursor: pointer;
		transition:
			background-color var(--duration-fast) var(--ease-out-quart),
			color var(--duration-fast) var(--ease-out-quart);
	}

	.payment-tab.is-active {
		background: var(--color-ink);
		color: var(--color-paper);
	}

	.payment-panel {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-sm);
		text-align: center;
	}

	.payment-qr {
		width: 240px;
		height: 240px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-paper-sunk);
	}

	.payment-qr img {
		display: block;
		width: 100%;
		height: 100%;
	}

	.payment-qr__placeholder {
		width: 60%;
		height: 60%;
		border: 2px dashed var(--color-border-strong);
	}

	.payment-panel__note {
		font-size: var(--text-body);
		max-width: 26ch;
	}

	.payment-bank {
		width: 100%;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		text-align: left;
		border: 1px solid var(--color-border);
		padding: var(--space-lg);
	}

	.payment-bank div {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-md);
	}

	.payment-bank dt {
		color: var(--color-graphite);
		font-size: var(--text-label);
	}

	.payment-bank dd {
		margin: 0;
		font-size: var(--text-body);
		font-weight: 500;
		text-align: right;
	}

	.payment-confirm {
		width: 100%;
	}

	.payment-note {
		margin: 0;
		text-align: center;
		font-size: var(--text-caption);
		color: var(--color-graphite);
	}

	.checkout-empty {
		padding-block: var(--space-3xl);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-md);
	}
</style>
