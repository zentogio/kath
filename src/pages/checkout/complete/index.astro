---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Thank You" description="Your order has been received.">
	<section class="container complete" data-complete-content hidden>
		<p class="eyebrow" data-i18n="complete.eyebrow">Thank You</p>
		<h1 class="display complete__title" data-complete-title></h1>
		<p class="prose complete__lead" data-complete-lead></p>
		<div class="complete__ctas">
			<a href="/collection" class="btn btn-primary" data-i18n="complete.continueShopping">Continue Shopping</a>
			<a href="/contact" class="btn btn-ghost" data-i18n="common.getInTouch">Get in Touch</a>
		</div>
	</section>

	<div class="container checkout-empty" data-checkout-empty hidden>
		<p class="prose" data-i18n="complete.empty">No recent order found.</p>
		<a href="/collection" class="btn btn-ghost" data-i18n="common.browseCollection">Browse the Collection</a>
	</div>

	<script src="../../../scripts/checkout-complete.ts"></script>
</Layout>

<style>
	.complete {
		padding-block: var(--space-3xl) var(--space-4xl);
		max-width: 36rem;
	}

	.complete__title {
		margin: var(--space-sm) 0 var(--space-md);
	}

	.complete__lead {
		font-size: var(--text-body-lg);
	}

	.complete__ctas {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		margin-top: var(--space-lg);
	}

	.checkout-empty {
		padding-block: var(--space-3xl);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-md);
	}
</style>
