---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Thank You" description="Your order has been received.">
	<section class="container complete" data-complete-content hidden>
		<p class="eyebrow">Thank You</p>
		<h1 class="display complete__title">Order received, <span data-complete-name></span>.</h1>
		<p class="prose complete__lead">
			We'll confirm your payment shortly and be in touch about shipping. Your order
			number is <strong data-complete-order-id></strong> — total <strong
				data-complete-total></strong
			>.
		</p>
		<div class="complete__ctas">
			<a href="/collection" class="btn btn-primary">Continue Shopping</a>
			<a href="/contact" class="btn btn-ghost">Get in Touch</a>
		</div>
	</section>

	<div class="container checkout-empty" data-checkout-empty hidden>
		<p class="prose">No recent order found.</p>
		<a href="/collection" class="btn btn-ghost">Browse the Collection</a>
	</div>

	<script src="../../../scripts/checkout-complete.ts"></script>
</Layout>

<style>
	.complete {
		padding-block: var(--space-3xl) var(--space-4xl);
		max-width: 36rem;
	}

	.complete__title {
		margin: var(--space-sm) 0 var(--space-md);
	}

	.complete__lead {
		font-size: var(--text-body-lg);
	}

	.complete__ctas {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		margin-top: var(--space-lg);
	}

	.checkout-empty {
		padding-block: var(--space-3xl);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-md);
	}
</style>
