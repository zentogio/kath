---
import Layout from '../layouts/Layout.astro';
import { productImage } from '../data/products';

const steps = [
	{
		n: '01',
		title: 'Pattern',
		titleKey: 'about.step1Title',
		body: 'Every silhouette starts on paper, adjusted by hand against a dress form until the drape is right — not pulled from a stock block.',
		bodyKey: 'about.step1Body',
	},
	{
		n: '02',
		title: 'Cut',
		titleKey: 'about.step2Title',
		body: "A single length of cloth, marked in chalk, cut by one person from start to finish. No two bolts lay quite the same, so no two cuts are either.",
		bodyKey: 'about.step2Body',
	},
	{
		n: '03',
		title: 'Sew',
		titleKey: 'about.step3Title',
		body: 'Seams are set, pressed, and set again. Where a machine can\'t reach — a collar, a hem, a buttonhole — it\'s finished by hand.',
		bodyKey: 'about.step3Body',
	},
	{
		n: '04',
		title: 'Number',
		titleKey: 'about.step4Title',
		body: "Each finished piece is counted against the run and logged. When the numbers run out, that piece is retired until the next cut.",
		bodyKey: 'about.step4Body',
	},
];
---

<Layout
	title="About"
	description="The story behind Studio Kath — a small studio cutting clothing by hand, in limited numbers."
>
	<header class="container about-header">
		<p class="eyebrow" data-i18n="about.eyebrow">About the Studio</p>
		<h1 class="display about-header__title" data-i18n="about.title">Slow, on purpose.</h1>
		<p class="prose about-header__lead" data-i18n="about.lead">
			Studio Kath started from a simple frustration: most clothing is designed to be
			replaced. We wanted to make the opposite — pieces cut with enough care that
			replacing them never crosses your mind.
		</p>
	</header>

	<section class="about-founding">
		<div class="container about-founding__grid">
			<div class="about-founding__copy" data-reveal>
				<p class="eyebrow" data-i18n="about.foundingEyebrow">About Studio Kath</p>
				<p class="prose" data-i18n="about.founding1">
					Founded in 2019, Studio Kath was born from a lifelong passion for bespoke
					tailoring. Inspired by our founder's mother, a skilled dressmaker, the brand was
					created to preserve the beauty and craftsmanship of made-to-measure clothing.
				</p>
				<p class="prose" data-i18n="about.founding2">
					We believe there is something truly special about designing your own
					garment—choosing the fabric, creating a style that reflects your personality, and
					wearing clothing that is tailored to fit you perfectly. Every custom-made piece is
					unique, made exclusively for you.
				</p>
				<p class="prose" data-i18n="about.founding3">
					At Studio Kath, every design can be made to order, allowing each customer to
					experience the elegance, confidence, and individuality that only bespoke clothing
					can offer.
				</p>
			</div>
			<div class="about-founding__media" data-reveal="right">
				<img
					src={productImage('blouse-lavender-puff')}
					alt="A model in the lavender puff-sleeve blouse"
					width={1206}
					height={1809}
					loading="lazy"
					class="about-founding__image"
				/>
			</div>
		</div>
	</section>

	<section class="about-story">
		<div class="container about-story__grid">
			<div class="about-story__media" data-reveal>
				<img
					src={productImage('halter-top-ivory')}
					alt="A model in the ivory linen halter top"
					width={1206}
					height={1508}
					loading="lazy"
					class="about-story__image"
				/>
			</div>
			<div class="about-story__copy" data-reveal>
				<h2 class="headline" data-i18n="about.storyHeadline">One studio, one size of ambition.</h2>
				<p class="prose" data-i18n="about.story1">
					We're not trying to become a big brand. Every piece that leaves the studio has
					been touched by hand at least three times — cut, sewn, and finished — by
					someone who'll tell you exactly why it's made the way it is.
				</p>
				<p class="prose" data-i18n="about.story2">
					That means we can only make so much in a season. We've made peace with that.
					It's the only way the quality stays honest.
				</p>
			</div>
		</div>
	</section>

	<section class="container process">
		<h2 class="headline process__heading" data-i18n="about.processHeadline">How a piece gets made</h2>
		<ol class="process__list" data-reveal-group>
			{
				steps.map((step, index) => (
					<li class="process__step" data-reveal style={`--i: ${index}`}>
						<span class="process__number display">{step.n}</span>
						<div>
							<p class="title" data-i18n={step.titleKey}>{step.title}</p>
							<p class="prose" data-i18n={step.bodyKey}>{step.body}</p>
						</div>
					</li>
				))
			}
		</ol>
	</section>

	<section class="detail-strip" data-reveal-group>
		<figure class="detail-strip__item" data-reveal>
			<img
				src={productImage('trousers-indigo-gingham')}
				alt="A model in the indigo gingham wide-leg trousers"
				width={1080}
				height={1080}
				loading="lazy"
			/>
		</figure>
		<figure class="detail-strip__item" data-reveal style="--i: 1">
			<img
				src={productImage('crop-top-lime')}
				alt="A model in the lime cropped satin top"
				width={1144}
				height={1430}
				loading="lazy"
			/>
		</figure>
		<figure class="detail-strip__item" data-reveal style="--i: 2">
			<img
				src={productImage('trousers-mint')}
				alt="A model in the mint pleated wide-leg trousers"
				width={828}
				height={1104}
				loading="lazy"
			/>
		</figure>
	</section>

	<section class="closing-band">
		<div class="container closing-band__inner">
			<h2 class="headline" data-i18n="about.closingHeadline">Have a question about a piece, or want to visit the studio?</h2>
			<a href="/contact" class="btn btn-ghost on-dark" data-i18n="common.getInTouch">Get in Touch</a>
		</div>
	</section>
</Layout>

<style>
	.about-header {
		padding-top: var(--space-2xl);
		max-width: 42rem;
	}

	.about-header__title {
		margin-block: var(--space-sm) var(--space-md);
	}

	.about-header__lead {
		font-size: var(--text-body-lg);
	}

	.about-founding {
		padding-block: var(--space-2xl) 0;
	}

	.about-founding__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-xl);
		align-items: center;
	}

	@media (min-width: 860px) {
		.about-founding__grid {
			grid-template-columns: 1fr 0.9fr;
			gap: var(--space-3xl);
		}
	}

	.about-founding__media {
		overflow: hidden;
	}

	.about-founding__image {
		width: 100%;
		height: auto;
		object-fit: cover;
		filter: contrast(1.03) saturate(1.05);
	}

	.about-founding__copy .eyebrow {
		margin-bottom: var(--space-md);
	}

	.about-founding__copy .prose + .prose {
		margin-top: var(--space-md);
	}

	.about-story {
		padding-block: var(--space-2xl);
	}

	.about-story__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-xl);
		align-items: center;
	}

	@media (min-width: 860px) {
		.about-story__grid {
			grid-template-columns: 0.9fr 1fr;
			gap: var(--space-3xl);
		}
	}

	.about-story__media {
		overflow: hidden;
	}

	.about-story__image {
		width: 100%;
		height: auto;
		object-fit: cover;
		filter: contrast(1.03) saturate(1.05);
	}

	.about-story__copy .headline {
		margin-bottom: var(--space-md);
	}

	.about-story__copy .prose + .prose {
		margin-top: var(--space-md);
	}

	.process {
		padding-block: var(--space-3xl);
		border-top: 1px solid var(--color-border);
	}

	.process__heading {
		margin-bottom: var(--space-xl);
		max-width: 24ch;
	}

	.process__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-xl) var(--space-2xl);
	}

	@media (min-width: 700px) {
		.process__list {
			grid-template-columns: 1fr 1fr;
		}
	}

	.process__step {
		display: flex;
		gap: var(--space-md);
	}

	.process__number {
		font-size: 1.5rem;
		color: var(--color-accent);
		flex-shrink: 0;
		line-height: 1;
	}

	.process__step .title {
		margin-bottom: 0.35em;
	}

	.detail-strip {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2px;
		background: var(--color-border);
	}

	.detail-strip__item {
		margin: 0;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: var(--color-paper-sunk);
	}

	.detail-strip__item :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: contrast(1.03) saturate(1.05);
	}

	.closing-band {
		background: var(--color-ink);
		margin-top: 0;
	}

	.closing-band__inner {
		padding-block: var(--space-2xl);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-lg);
	}

	.closing-band__inner .headline {
		color: var(--color-paper);
		max-width: 30ch;
	}
</style>
